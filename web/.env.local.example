# Copy to web/.env.local for local work. On Vercel, set these in Project Settings →
# Environment Variables instead.

# The deployed RitualPredict address. Printed by hardhat/scripts/deploy.ts, or by
# hardhat/scripts/local-demo.ts for a local run. Can also be pasted into the UI.
#
# Leave it unset and the market board shows clearly-labelled sample markets rather than
# an empty page — which is the right state for a public deployment with no reachable
# contract. It is never a substitute for a real one: any successful read wins.
NEXT_PUBLIC_PREDICT_ADDRESS=

# Which network the app opens on: 31337 (local Hardhat) or 1979 (Ritual Chain).
# Unset, it picks local when served from localhost and Ritual otherwise — a deployed
# build must never default to 127.0.0.1, which means "my own machine" to every visitor.
# On Vercel set this to 1979.
# NEXT_PUBLIC_DEFAULT_CHAIN_ID=1979

# Where the demo oracle lives. Leave UNSET for local work: the app derives it from the
# origin the page was loaded from, which matters because Next.js falls back to port 3001
# when 3000 is taken, and a preset pointing at the wrong port creates a market that can
# never resolve.
#
# Set it only to a publicly reachable URL, which is what a real chain needs: the HTTP
# precompile is called by a TEE executor in the cloud, so loopback never resolves.
#   cloudflared tunnel --url http://localhost:3000
# NEXT_PUBLIC_DEMO_ORACLE_URL=https://your-tunnel.example/api/oracle/eth

# Optional RPC override for Ritual Chain.
# NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
