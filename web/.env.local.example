# Copy to web/.env.local

# The deployed RitualPredict address. Printed by hardhat/scripts/deploy.ts, or by
# hardhat/scripts/local-demo.ts for a local run. Can also be set in the UI.
NEXT_PUBLIC_PREDICT_ADDRESS=

# Where the demo oracle lives. Leave this UNSET for local work: the app then derives it
# from the origin you actually loaded the page from, which matters because Next.js falls
# back to port 3001 whenever 3000 is taken — a preset pointing at the wrong port creates
# a market that can never resolve.
#
# Set it only to point at a publicly reachable URL, which is what a real chain needs: the
# HTTP precompile is called by a TEE executor in the cloud, so loopback never resolves.
#   cloudflared tunnel --url http://localhost:3000
# NEXT_PUBLIC_DEMO_ORACLE_URL=https://your-tunnel.example/api/oracle/eth

# Optional RPC override for Ritual Chain.
# NEXT_PUBLIC_RITUAL_RPC_URL=https://rpc.ritualfoundation.org
